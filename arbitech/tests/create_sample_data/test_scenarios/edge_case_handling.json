    "maximum_crash_rate": 0.05,
    "timeout_handling": "must_handle_gracefully"
  },
  "edge_case_categories": {
    "interface_issues": {
      "description": "Problems with the interface itself",
      "cases": ["partial_interface", "low_resolution", "overlay_elements"],
      "handling_expectation": "graceful_degradation"
    },
    "loading_issues": {
      "description": "Problems during content loading",
      "cases": ["loading_state", "timeout", "connection_issues"],
      "handling_expectation": "timeout_and_retry"
    },
    "data_issues": {
      "description": "Problems with the data content",
      "cases": ["error_page", "maintenance_mode", "no_data"],
      "handling_expectation": "clear_error_reporting"
    },
    "format_issues": {
      "description": "Problems with data format or language",
      "cases": ["multilingual", "unusual_format", "custom_layout"],
      "handling_expectation": "best_effort_extraction"
    }
  },
  "evaluation_metrics": {
    "graceful_failure_rate": "percentage of edge cases handled without crashes",
    "error_detection_accuracy": "percentage of actual errors correctly identified",
    "false_positive_rate": "percentage of valid interfaces misidentified as errors",
    "recovery_time": "time to recover from edge cases and resume normal operation"
  }
